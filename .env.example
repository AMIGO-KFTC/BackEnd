# AMIGO BackEnd 설정 — 이 파일을 .env 로 복사해서 씁니다(scripts/setup.sh·setup.ps1 이 자동으로 복사).
# .env 는 git 에 올라가지 않습니다. API 키는 .env 에만 적고 이 예시 파일에는 적지 마세요.
# 값 뒤에 주석을 붙이지 말고, 설명은 윗줄에 씁니다. 고친 뒤에는 백엔드를 다시 시작하세요.

# ---- AI (Claude) -------------------------------------------------------------
# API 키가 없으면 규칙 기반 오프라인 엔진으로 동작합니다(데모·개발용).
ANTHROPIC_API_KEY=
# auto(키가 있으면 Claude, 없으면 오프라인) | claude | offline
AMIGO_LLM_MODE=auto
# 사용할 모델. 비용 순: claude-haiku-4-5(가장 저렴) < claude-sonnet-5-5(약 2배) < claude-opus-5-5(약 4배, 품질 가장 좋음)
AMIGO_LLM_MODEL=claude-haiku-4-5
# Claude API 추정 비용 상한(USD, 모든 세션 합계). 넘으면 새 AI 작업을 막음. 0 이면 제한 없음
AMIGO_LLM_BUDGET_USD=0
# 안전 분류기가 요청을 거절하면 서버 측 대체 모델로 재시도(기본 true)
# AMIGO_LLM_FALLBACKS=true

# ---- 서버 --------------------------------------------------------------------
# SQLite DB, 업로드 파일, ChromaDB, 대화 체크포인트를 저장할 폴더(BackEnd 기준)
AMIGO_DATA_DIR=./data
AMIGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AMIGO_MAX_UPLOAD_MB=50
# PostgreSQL 을 쓰려면 드라이버 설치(pip install "psycopg[binary]") 후 주석 해제
# AMIGO_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/amigo
# 빌드된 화면(FrontEnd 에서 npm run build)을 이 서버(8000)에서 함께 제공
# AMIGO_FRONTEND_DIST=../FrontEnd/dist

# ---- 링크 수집 ----------------------------------------------------------------
# 컨플루언스 Server/Data Center: 주소 + 개인 액세스 토큰
# CONFLUENCE_BASE_URL=https://wiki.example.com
# CONFLUENCE_PAT=
# 컨플루언스 Cloud: 주소 + 이메일 + API 토큰
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=
# 나누미: 주소 + 로그인 쿠키(또는 NANUMI_AUTH_HEADER)
# NANUMI_BASE_URL=https://nanumi.example.com
# NANUMI_COOKIE=
# 링크 수집을 허용할 도메인(쉼표로 구분, 비우면 모두 허용)
# AMIGO_RAG_ALLOWED_HOSTS=example.com

# ---- 문서 내보내기 -------------------------------------------------------------
# PDF 에 넣을 한글 글꼴(자동으로 찾지 못할 때만 지정)
# AMIGO_PDF_FONT=C:/Windows/Fonts/malgun.ttf
# AMIGO_PDF_FONT_BOLD=C:/Windows/Fonts/malgunbd.ttf
