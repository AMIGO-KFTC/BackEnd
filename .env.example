# ---- AI (Claude) -------------------------------------------------------------
# API 키가 없으면 규칙 기반 오프라인 엔진으로 동작합니다(데모·개발용).
ANTHROPIC_API_KEY=
AMIGO_LLM_MODE=auto                # auto | claude | offline
AMIGO_LLM_MODEL=claude-opus-5-5
# AMIGO_LLM_FALLBACKS=true         # 안전 분류기 거절 시 서버 측 대체 모델로 재시도

# ---- 서버 --------------------------------------------------------------------
AMIGO_DATA_DIR=./data              # SQLite DB, 업로드 파일, ChromaDB, 대화 체크포인트
AMIGO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AMIGO_MAX_UPLOAD_MB=50
# AMIGO_DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/amigo
# AMIGO_FRONTEND_DIST=../FrontEnd/dist   # 빌드된 화면을 같은 서버(8000)에서 제공

# ---- 링크 수집 ----------------------------------------------------------------
# CONFLUENCE_BASE_URL=https://wiki.example.com
# CONFLUENCE_PAT=                  # Server/DC 개인 액세스 토큰
# CONFLUENCE_EMAIL= / CONFLUENCE_API_TOKEN=   # Cloud
# NANUMI_BASE_URL=https://nanumi.example.com
# NANUMI_COOKIE=
# AMIGO_RAG_ALLOWED_HOSTS=example.com   # 링크 수집 허용 도메인

# ---- 문서 내보내기 -------------------------------------------------------------
